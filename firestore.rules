rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============ SUBSCRIPTIONS ============
    // Users can read their own subscription doc (email = doc ID)
    // Users can create their own doc on first registration
    // Admin email gets full access to all subscription docs
    match /subscriptions/{email} {
      allow read: if request.auth != null && request.auth.token.email == email;
      allow create: if request.auth != null && request.auth.token.email == email;
      allow update: if request.auth != null && (
        request.auth.token.email == email ||
        request.auth.token.email == 'gurubhat21@gmail.com'
      );
      allow delete: if request.auth != null &&
        request.auth.token.email == 'gurubhat21@gmail.com';
    }

    // Admin: full access to all subscriptions (for listing)
    match /subscriptions/{email} {
      allow read, write: if request.auth != null &&
        request.auth.token.email == 'gurubhat21@gmail.com';
    }

    // ============ CLOUD SYNC DATA ============
    // Existing cloud sync collections - allow authenticated users
    match /cloud_sync/{userId}/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Allow authenticated users to access their sync data
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
